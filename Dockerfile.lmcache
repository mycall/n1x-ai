FROM n1x-ai:magi-v5
ENV LMCACHE_TRACK_USAGE=false DO_NOT_TRACK=1 VLLM_NO_USAGE_STATS=1 HF_HUB_DISABLE_TELEMETRY=1 \
    N1X_LMCACHE_STAGED_TRANSFER=1 N1X_RESTORE_WAIT_MS=0
COPY runtime/lmcache/constraints.txt /opt/lmcache-constraints.txt
RUN --mount=type=secret,id=https_proxy --mount=type=secret,id=http_proxy \
    HTTPS_PROXY="$(cat /run/secrets/https_proxy 2>/dev/null)" \
    HTTP_PROXY="$(cat /run/secrets/http_proxy 2>/dev/null)" \
    uv pip install --python /opt/venv/bin/python -c /opt/lmcache-constraints.txt \
      lmcache==0.5.6 'torch==2.13.0' 'vllm==0.32.0' 'flashinfer-python==0.7.0.post1'
COPY runtime/lmcache/n1x_*.py /opt/venv/lib/python3.12/site-packages/
COPY runtime/lmcache/patch_*.py /tmp/n1x-patches/
RUN python /tmp/n1x-patches/patch_vmm.py && \
    python /tmp/n1x-patches/patch_admission.py && \
    python /tmp/n1x-patches/patch_segmented.py && \
    python /tmp/n1x-patches/patch_restore_queue_v2.py
COPY runtime/lmcache/serve.py /opt/n1x/serve.py
COPY LICENSE NOTICE.md licenses/Apache-2.0.txt /opt/n1x/licenses/
ENTRYPOINT ["python", "-u", "/opt/n1x/serve.py"]
