ARG COMPARISON_IMAGE=n1x-ai:lmcache-optimization-test
FROM ${COMPARISON_IMAGE}
ARG COMPARISON_IMAGE_ID
RUN test -n "$COMPARISON_IMAGE_ID"
LABEL n1x-ai.comparison-base="${COMPARISON_IMAGE_ID}"
LABEL n1x-ai.restore-queue-version="2"
COPY n1x_restore_queue_v2.py /opt/venv/lib/python3.12/site-packages/n1x_restore_queue_v2.py
COPY patch_restore_queue_v2.py /tmp/patch_restore_queue_v2.py
RUN python /tmp/patch_restore_queue_v2.py
